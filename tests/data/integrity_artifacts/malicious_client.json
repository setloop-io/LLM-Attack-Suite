        "query/update intake policy stack (validation, budgets, anomaly detection)",
        "captured client-stream journals (offline policy replay)"
      ],
      "out_of_scope": [
        "nonlinear bodies, attention, LayerNorm (linear 12x8 slice only)",
        "cross-tenant sybil attribution (colluders share one tenant)",
