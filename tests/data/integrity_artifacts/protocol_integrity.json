  "threat_model": {
    "schema": "llm_attacker.threat_model.v2",
    "summary": "active inline network attacker / malicious relay / compromised proxy on the split client<->server frame path: observes and mutates protocol frames (replay, reorder, duplicate, drop, cross-session swap, epoch desync, downgrade, tensor tamper, oversize, truncate) without possessing endpoint keys. Tests the integrity and availability of the split protocol itself, not the confidentiality of the tensors crossing it.",
    "scope": {
      "use_case": "split-training",
      "deployment": "multi-tenant",
      "in_scope": [
        "split-training activation/gradient frame streams (epochs, key rotation)",
        "split-inference prefill/decode frame streams",
        "the bidirectional client<->server protocol: framing, negotiation, session/epoch state"
      ],
      "out_of_scope": [
        "payload confidentiality (seam-inversion family)",
        "endpoint key theft / insiders holding keys",
        "crash/hang modeling (the simulator reports accept/reject only)",
        "drop detection via liveness/gap tracking"
      ]
    },
    "actor": {
      "role": "network",
      "vantage": [
        "inline on the frame path",
        "malicious relay or compromised proxy"
      ],
      "intent": "active",
      "authorization": "none: no endpoint keys, no tenant credentials",
      "privileges": [],
      "knowledge": [
        "the framing schema llm_attacker.protocol_frames.v1",
        "per-frame metadata incl. the unkeyed payload hashes"
      ],
      "capabilities": [
        "observe frames in both directions",
        "modify, inject, reorder, duplicate and drop frames",
        "capture frames across sessions/epochs for replay"
      ],
      "resources": [
        "a captured frame journal or a synthetic stream"
      ],
      "persistence": "session",
      "collusion": []
    },
    "target": {
